# Parkify environment template
# Copy to .env and adjust values for local development.

# Application environment: development | production
PARKIFY_ENV=development

# Flask secret key (override in production)
SECRET_KEY=change-me-in-production

# Optional runtime overrides (otherwise loaded from YAML config)
# HOST=127.0.0.1
# PORT=5001
# DEBUG=true
# LOG_LEVEL=DEBUG
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Neon PostgreSQL. Paste the connection strings from the Neon dashboard.
# Use the pooled hostname for the running Flask app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/parkify?sslmode=require

# Use the direct (non-pooled) hostname for Alembic. Falls back to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/parkify?sslmode=require

# Isolated Neon branch or database used only by pytest. Do not reuse DATABASE_URL.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/parkify_test?sslmode=require
